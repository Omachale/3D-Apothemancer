[gd_resource type="StandardMaterial3D" format=3]

; Same additive/unshaded convention as dark_bolt.tres. Slightly hotter energy
; than the other bolts since this one is meant to read as "crackling".

[resource]
transparency = 1
blend_mode = 1
cull_mode = 2
shading_mode = 0
albedo_color = Color(0.15, 0.45, 0.95, 1)
emission_enabled = true
emission = Color(0.35, 0.65, 1, 1)
emission_energy_multiplier = 2.2
