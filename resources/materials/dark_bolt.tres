[gd_resource type="StandardMaterial3D" format=3]

; Additive and unshaded, so the bolt reads as light rather than as a solid
; ball. Energy is kept deliberately low: additive blending sums albedo and
; emission, and anything much above 2 saturates every channel and the bolt
; turns white, losing the colour that identifies whose magic it is.

[resource]
transparency = 1
blend_mode = 1
cull_mode = 2
shading_mode = 0
albedo_color = Color(0.34, 0.09, 0.68, 1)
emission_enabled = true
emission = Color(0.45, 0.11, 0.88, 1)
emission_energy_multiplier = 1.9
